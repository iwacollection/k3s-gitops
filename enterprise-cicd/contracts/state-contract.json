{
  "version": "v2",
  "backend": {
    "type": "azurerm",
    "storage": "azure-blob",
    "authentication": "entra-id-rbac",
    "shared_access_key_allowed": false,
    "container_name": "tfstate",
    "backend_config_delivery": "runtime-not-committed"
  },
  "state_rules": {
    "commit_state_to_git": false,
    "cross_environment_state_access": false,
    "plan_write_access": false,
    "apply_write_access": true,
    "split_when_owner_differs": true,
    "split_when_lifecycle_differs": true,
    "split_when_rbac_differs": true,
    "split_high_blast_radius_platform_from_workloads": true,
    "catalog_request_state_isolated": true,
    "environment_scoped_platform_state_isolated": true
  },
  "platform_keys": {
    "governance": "platform/governance.tfstate",
    "identity": "platform/identity.tfstate",
    "management": "platform/management.tfstate",
    "acr": "platform/acr.tfstate",
    "aks": "platform/aks.tfstate"
  },
  "environment_scoped_platform_stacks": [
    "connectivity",
    "observability",
    "aks-observability"
  ],
  "platform_environment_key_pattern": "platform/{environment}/{stack}.tfstate",
  "workload_key_pattern": "workload/{environment}/{workload}.tfstate",
  "catalog_key_pattern": "catalog/{environment}/{service}/{request}.tfstate",
  "production_target": {
    "platform_and_workload_backend_separation": "recommended-by-risk-and-scale",
    "environment_isolation": "separate-rbac-and-prefer-separate-storage-scope"
  },
  "lab_mapping": {
    "one_storage_account_allowed": true,
    "separate_state_keys_required": true,
    "backend_resource_group": "rg-platform-cicd"
  }
}
