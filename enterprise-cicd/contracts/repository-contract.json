{
  "version": "v1",
  "development_model": {
    "branching": "trunk-based",
    "default_branch": "main",
    "long_lived_environment_branches_allowed": false,
    "same_iac_code_promoted_across_environments": true
  },
  "target_repositories": {
    "azure-platform-iac": {
      "owner": "platform-sre-cloud",
      "scope": ["governance", "connectivity", "identity", "management", "acr", "aks", "shared-modules"],
      "application_team_direct_write": false
    },
    "azure-workload-iac": {
      "owner": "workload-team-with-platform-guardrails",
      "scope": ["application-specific-azure-resources", "workload-identities"],
      "platform_guardrails_required": true
    },
    "cicd-templates": {
      "owner": "platform-devops",
      "scope": ["github-actions", "azure-devops", "terraform", "security", "deployment"],
      "required_template_source": true
    },
    "build-images": {
      "owner": "platform-devops",
      "scope": ["go", "python", "java", "cpp", "infra-toolbox"]
    },
    "gitops-environments": {
      "owner": "platform-and-workload",
      "scope": ["clusters/dev", "clusters/test", "clusters/prod", "applications"],
      "kubernetes_desired_state_source": true
    },
    "application-repositories": {
      "owner": "application-team",
      "scope": ["source", "tests", "dockerfile", "minimal-ci-adapter"],
      "platform_iac_allowed": false
    }
  },
  "lab_mapping": {
    "integration_repository": "iwacollection/k3s-gitops",
    "monorepo_is_temporary": true,
    "directories_must_preserve_target_repository_boundaries": true
  }
}
