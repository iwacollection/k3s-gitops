{
  "version": 1,
  "environments": {
    "dev": {
      "location": "eastus",
      "connectivity": {
        "resource_group_name": "rg-platform-network-dev",
        "virtual_network_name": "vnet-platform-dev",
        "address_space": ["10.240.0.0/16"],
        "network_security_groups": {},
        "route_tables": {},
        "nat_gateway": null,
        "subnets": {
          "snet-private-endpoints": {
            "address_prefixes": ["10.240.10.0/24"],
            "service_endpoints": [],
            "use_nat_gateway": false
          },
          "snet-postgresql": {
            "address_prefixes": ["10.240.20.0/24"],
            "service_endpoints": [],
            "use_nat_gateway": false,
            "delegation": {
              "name": "postgresql-flexible",
              "service_name": "Microsoft.DBforPostgreSQL/flexibleServers",
              "actions": ["Microsoft.Network/virtualNetworks/subnets/join/action"]
            }
          }
        },
        "private_dns_zone_names": [
          "privatelink.blob.core.windows.net",
          "privatelink.vaultcore.azure.net",
          "privatelink.servicebus.windows.net",
          "privatelink.redis.azure.net",
          "platform-dev.postgres.database.azure.com"
        ]
      },
      "observability": {
        "resource_group_name": "rg-platform-observability-dev",
        "log_analytics_name": "law-platform-dev",
        "monitor_workspace_name": "amw-platform-dev",
        "log_retention_days": 30,
        "daily_quota_gb": 1,
        "internet_ingestion_enabled": true,
        "internet_query_enabled": true,
        "monitor_public_network_access_enabled": true
      }
    },
