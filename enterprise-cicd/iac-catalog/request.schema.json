{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example/schemas/iac-request-v1.json",
  "title": "Enterprise IaC Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.iac/v1"},
    "kind": {"const": "InfrastructureRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "application"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,50}$"},
        "owner": {"type": "string", "minLength": 3},
        "application": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,50}$"},
        "costCenter": {"type": "string", "minLength": 2}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "region", "service", "templateVersion", "parameters"],
      "properties": {
        "environment": {"enum": ["dev", "test", "prod"]},
        "region": {"type": "string", "minLength": 2},
        "service": {"type": "string", "minLength": 2},
        "templateVersion": {"type": "string", "pattern": "^v[0-9]+$"},
        "parameters": {"type": "object"}
      }
    }
  }
}
