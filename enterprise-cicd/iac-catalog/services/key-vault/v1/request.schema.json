{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Key Vault Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "purgeProtection", "softDeleteRetentionDays", "publicNetworkAccess"],
  "properties": {
    "sku": {"enum": ["Standard", "Premium"]},
    "purgeProtection": {"const": true},
    "softDeleteRetentionDays": {"type": "integer", "minimum": 7, "maximum": 90},
    "publicNetworkAccess": {"enum": ["Enabled", "Disabled"]}
  }
}
