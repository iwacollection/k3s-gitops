{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storage Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["replication", "accessTier", "publicNetworkAccess", "sharedKeyAccess", "blobVersioning", "deleteRetentionDays"],
  "properties": {
    "replication": {"enum": ["LRS", "ZRS", "GRS", "GZRS"]},
    "accessTier": {"enum": ["Hot", "Cool"]},
    "publicNetworkAccess": {"enum": ["Enabled", "Disabled"]},
    "sharedKeyAccess": {"const": false},
    "blobVersioning": {"type": "boolean"},
    "deleteRetentionDays": {"type": "integer", "minimum": 7, "maximum": 365}
  }
}
