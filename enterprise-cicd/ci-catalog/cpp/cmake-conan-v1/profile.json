{
  "apiVersion": "platform.ci/v1",
  "kind": "BuildProfile",
  "metadata": {"name": "cmake-conan-v1", "language": "cpp", "version": "v1"},
  "spec": {
    "buildImage": "cpp-cmake-conan:v1",
    "dependencyProxy": "cpp",
    "commands": {
      "prepare": "conan profile detect --force && conan install . --output-folder=build --build=missing -s build_type=Release && cmake -S . -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release",
      "verify": "cmake --build build --config Release && ctest --test-dir build --output-on-failure",
      "package": "cmake --install build --prefix dist"
    },
    "outputs": ["binary", "container"],
    "requiredControls": ["unit-test", "secret-scan", "sca", "sast", "sbom", "container-scan", "sign", "provenance"],
    "cacheKeyInputs": ["conan.lock", "conanfile.py", "conanfile.txt", "CMakeLists.txt", "compiler", "compiler-version", "libc", "build-image-version", "architecture"]
  }
}
