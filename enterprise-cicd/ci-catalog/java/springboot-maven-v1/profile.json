{
  "apiVersion": "platform.ci/v1",
  "kind": "BuildProfile",
  "metadata": {"name": "springboot-maven-v1", "language": "java", "version": "v1"},
  "spec": {
    "buildImage": "java21-maven:v1",
    "dependencyProxy": "maven",
    "commands": {"prepare": "true", "verify": "mvn -B verify", "package": "mvn -B -DskipTests package"},
    "outputs": ["jar", "container"],
    "requiredControls": ["unit-test", "secret-scan", "sca", "sast", "sbom", "container-scan", "sign", "provenance"],
    "cacheKeyInputs": ["pom.xml", "java-version", "build-image-version", "architecture"]
  }
}
