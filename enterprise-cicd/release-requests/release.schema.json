{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform Release Request",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.release/v1"},
    "kind": {"const": "Release"},
    "metadata": {
      "type": "object",
      "required": ["application", "owner"],
      "properties": {
        "application": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "owner": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["artifactRepository", "artifactDigest", "from", "to", "releaseProfile", "changeReason"],
      "properties": {
        "artifactRepository": {"type": "string", "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._/-]+$"},
        "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "from": {"enum": ["build", "dev", "test"]},
        "to": {"enum": ["dev", "test", "prod"]},
        "releaseProfile": {"type": "string"},
        "changeReason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
