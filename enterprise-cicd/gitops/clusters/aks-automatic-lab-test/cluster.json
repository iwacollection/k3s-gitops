{
  "apiVersion": "platform.gitops/v1",
  "kind": "ClusterBinding",
  "metadata": {
    "name": "aks-automatic-lab-test",
    "environment": "test"
  },
  "spec": {
    "labMode": "logical-environment-on-shared-aks",
    "namespaceManagement": "arm",
    "azure": {
      "resourceGroup": "group-test",
      "clusterName": "k8s-test-cicd",
      "clusterType": "managedClusters"
    },
    "flux": {
      "extension": "microsoft.flux",
      "configurationName": "enterprise-cicd-test",
      "namespace": "enterprise-cicd-test",
      "scope": "cluster",
      "repository": "https://github.com/iwacollection/k3s-gitops",
      "branch": "gitops/test",
      "kustomizations": [
        {
          "name": "apps-test",
          "path": "./enterprise-cicd/gitops/environments/test",
          "prune": true
        }
      ]
    }
  }
}
