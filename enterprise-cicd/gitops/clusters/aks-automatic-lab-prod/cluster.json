{
  "apiVersion": "platform.gitops/v1",
  "kind": "GitOpsCluster",
  "metadata": {
    "name": "aks-automatic-lab-prod",
    "provider": "azure",
    "environment": "prod"
  },
  "spec": {
    "managementMode": "gitops-only",
    "fluxProvider": "azure-k8s-configuration-flux-v2",
    "kubernetesWritePath": "flux-only",
    "directDeployFromCI": false,
    "azure": {
      "subscriptionId": "c12c3a36-99d8-4741-bcef-cd7df5d5cd4a",
      "resourceGroup": "group-test",
      "clusterName": "k8s-test-cicd",
      "clusterType": "managedClusters",
      "namespaceManagement": "arm",
      "namespaceOwnership": "arm-only-not-flux",
      "identityRef": "azure-prod-github-oidc-reader"
    },
    "flux": {
      "configurationName": "enterprise-cicd-prod",
      "namespace": "enterprise-cicd-prod",
      "scope": "cluster",
      "branch": "gitops/prod",
      "repositoryPath": "./enterprise-cicd/gitops/environments/prod",
      "kustomization": "apps-prod",
      "prune": true,
      "syncInterval": "1m",
      "timeout": "3m",
      "reconcileInfrastructurePath": false
    },
    "allowedPaths": [
      "enterprise-cicd/gitops/environments/prod/**"
    ],
    "applicationNamespace": "cicd-prod",
    "policy": {
      "imageDigestRequired": true,
      "namespaceMustExistBeforeFlux": true,
      "namespaceManifestForbiddenInFluxRoot": true,
      "progressiveDelivery": {
        "rolling": "execution-ready",
        "canary": "catalog-only",
        "blueGreen": "catalog-only"
      }
    }
  }
}
