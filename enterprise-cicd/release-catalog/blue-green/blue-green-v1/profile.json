{
  "apiVersion": "platform.release/v1",
  "kind": "ReleaseProfile",
  "metadata": {"name": "blue-green-v1", "strategy": "blue-green", "version": "v1"},
  "spec": {
    "requires": ["signed-artifact", "sbom", "health-check"],
    "steps": ["deploy-inactive-slot", "verify-inactive-slot", "switch-traffic", "verify-active-slot"],
    "rollback": {"automaticOnHealthFailure": true, "target": "previous-active-slot"}
  }
}
