{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment Verification Observation",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.verification/v1"},
    "kind": {"const": "DeploymentObservation"},
    "metadata": {
      "type": "object",
      "required": ["application", "environment"],
      "properties": {
        "application": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "environment": {"enum": ["dev", "test", "prod"]}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["artifactRepository", "artifactDigest", "fluxReady", "rolloutReady", "healthEndpointReady"],
      "properties": {
        "artifactRepository": {"type": "string", "minLength": 1},
        "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "fluxReady": {"type": "boolean"},
        "rolloutReady": {"type": "boolean"},
        "healthEndpointReady": {"type": "boolean"},
        "errorRatePercent": {"type": ["number", "null"], "minimum": 0},
        "p95LatencyMs": {"type": ["number", "null"], "minimum": 0},
        "observedAt": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
