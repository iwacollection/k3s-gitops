{
  "apiVersion": "platform.promotion/v1",
  "kind": "PromotionPolicy",
  "spec": {
    "allowedTransitions": ["build->dev", "dev->test", "test->prod"],
    "sameDigestRequired": true,
    "prod": {
      "approvalRequired": true,
      "protectedEnvironmentRequired": true,
      "signedArtifactRequired": true,
      "sbomRequired": true,
      "criticalVulnerabilityBlock": true
    }
  }
}
