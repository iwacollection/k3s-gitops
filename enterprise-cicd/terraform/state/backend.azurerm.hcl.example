# Runtime-generated backend config example.
# Do not commit real account/tenant/client identifiers in backend.hcl.
# Authentication is supplied by environment variables / OIDC at runtime.

resource_group_name  = "rg-platform-cicd"
storage_account_name = "<globally-unique-state-storage-account>"
container_name       = "tfstate"
key                  = "<state-contract-key>"

use_azuread_auth = true
use_oidc         = true

# Supplied at runtime where required:
# ARM_TENANT_ID
# ARM_CLIENT_ID
# ARM_SUBSCRIPTION_ID
# ARM_USE_AZUREAD=true
# ARM_USE_OIDC=true
# Azure DevOps additionally supplies the OIDC service connection context.
