{
  "apiVersion": "platform.azuredevops/v1",
  "kind": "TerraformServiceConnectionContract",
  "spec": {
    "authentication": "workload-identity-federation",
    "connections": {
      "dev": {
        "plan": "sc-tf-plan-dev",
        "apply": "sc-tf-apply-dev"
      },
      "test": {
        "plan": "sc-tf-plan-test",
        "apply": "sc-tf-apply-test"
      },
      "prod": {
        "plan": "sc-tf-plan-prod",
        "apply": "sc-tf-apply-prod"
      }
    },
    "plan": {
      "azureAccess": "read-only-at-target-scope",
      "stateAccess": "read",
      "mayApply": false
    },
    "apply": {
      "azureAccess": "minimum-required-write-at-target-scope",
      "stateAccess": "read-write",
      "savedPlanRequired": true
    },
    "prodApplyChecks": [
      "required-template",
      "branch-control",
      "manual-approval",
      "exclusive-lock"
    ],
    "serviceConnectionFromRuntimeVariableAllowed": false,
    "lockBehavior": "sequential"
  }
}
