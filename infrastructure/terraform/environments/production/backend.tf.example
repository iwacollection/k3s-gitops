terraform {
  backend "azurerm" {
    # Configure these values from secure environment variables or backend config.
    # Never commit production state credentials.
    resource_group_name  = "<terraform-state-resource-group>"
    storage_account_name = "<terraformstateaccount>"
    container_name       = "tfstate"
    key                  = "production/terraform.tfstate"
  }
}
